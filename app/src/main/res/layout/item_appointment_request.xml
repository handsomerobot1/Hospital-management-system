<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient: Mahmud Hasan"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"/>

        <TextView
            android:id="@+id/tvDoctorRequested"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor: Dr. Anika Rahman (Cardiologist)"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvRequestedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Requested Time: 3:00 PM"
            android:textSize="13sp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textColor="@color/warningOrange"
            android:textStyle="italic"
            android:layout_marginTop="6dp"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnCancelAppointment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/deleteRed"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnConfirmAppointment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/primaryBlue"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
